# Copy to backend/.env — never commit the real file.
# Get a key at https://one.verbxeco.com (Ziro email). Eligible teams: ZIRO26

VERBX_API_KEY=your_api_key_here
VERBX_API_BASE=https://api.verbxeco.com
# Auth: Bearer | X-Api-Key
VERBX_AUTH_MODE=Bearer

# Override if your VerbX dashboard shows different paths
VERBX_TRANSLATE_PATH=/v1/translate
VERBX_STT_PATH=/v1/stt
VERBX_TTS_PATH=/v1/tts

# Set to 1 only for local UI work without credits. Labelled as fallback in the UI.
VERBX_ALLOW_FALLBACK=1

HOST=127.0.0.1
PORT=8000
